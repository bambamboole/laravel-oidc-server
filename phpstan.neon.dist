includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    paths:
        - src
        - tests
        - workbench/app
    level: 6
    ignoreErrors:
        # InteractsWithOidc ships for consumers to `use` in their own test suites; it is never
        # composed via a literal `use TraitName;` statement inside this repo (only via Pest's dynamic
        # uses() in tests/Testing/InteractsWithOidcTest.php and the tests/Flow, tests/Protocol,
        # tests/Audit, tests/Clients, tests/Consents and tests/Credentials files), so PHPStan's static trait-usage scanner cannot see it
        # being applied. It is exercised by the tests in tests/Testing/InteractsWithOidcTest.php.
        -
            identifier: trait.unused
            message: '#Trait Bambamboole\\LaravelOidc\\Server\\Testing\\InteractsWithOidc is used zero times#'
            path: src/Testing/InteractsWithOidc.php
        # Same rationale as the InteractsWithOidc entry above: FakesAuthViews ships for consumers'
        # test suites and is only ever composed via Pest's dynamic uses() (tests/Testing/FakesAuthViewsTest.php),
        # never a literal `use TraitName;` inside this repo.
        -
            identifier: trait.unused
            message: '#Trait Bambamboole\\LaravelOidc\\Server\\Testing\\FakesAuthViews is used zero times#'
            path: src/Testing/FakesAuthViews.php
        # pest-plugin-phpstan types `$this` from the file-local uses(InteractsWithOidc::class) calls,
        # but a trait method declared `: static` comes back typed as the bare trait, so the next call
        # in a chain such as `$this->actingAsIdentity($user)->get(...)` is reported against an
        # "unknown class". The trait methods are exercised at runtime by the same tests.
        -
            identifier: class.notFound
            message: '#on an unknown class Bambamboole\\LaravelOidc\\Server\\Testing\\InteractsWithOidc#'
            path: tests/*
        # The plugin only types `$this`. The `TestCase $test` helper parameters in these files
        # receive the trait-composed test case at runtime, which PHPStan cannot see; a
        # `TestCase&InteractsWithOidc` PHPDoc is rejected as an unresolvable type because traits
        # are not types.
        -
            identifier: method.notFound
            message: '#Call to an undefined method Bambamboole\\LaravelOidc\\Server\\Tests\\TestCase::(actingAsIdentity|authorizeAndApprove)\(\)#'
            paths:
                - tests/Consents/ConsentRepositoryTest.php
                - tests/Flow/AuthorizationCodeFlowTest.php
                - tests/Flow/RefreshTokenFlowTest.php
                - tests/Protocol/TokenEndpointTest.php
